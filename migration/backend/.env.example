# ============================================
# SM Elite Hajj Invoice System - EXAMPLE CONFIG
# Copy to .env and replace placeholder values.
# NEVER commit the real .env file.
# ============================================

# Database (DEDICATED - port 5440, db: sm_elite_hajj)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=sm_elite_hajj
DB_USER=sm_elite_user
DB_PASSWORD=your-strong-database-password-here

# Server (DEDICATED - port 3012)
PORT=3012
JWT_SECRET=your-long-random-jwt-secret-at-least-32-chars

# Frontend URL (for CORS - LOCKED to this domain only)
CORS_ORIGIN=https://soft.smelitehajj.com
FRONTEND_URL=https://soft.smelitehajj.com

# Base URL for backend
BASE_URL=https://soft.smelitehajj.com/api

# File uploads directory (DEDICATED path)
UPLOADS_DIR=/var/www/smelitehajjinvoice/migration/backend/uploads
